# App Config
PROJECT_NAME="CareerBridge"
ENVIRONMENT="development"
SECRET_KEY="supersecretjwtkey_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default, falls back to SQLite for instant local dev)
DATABASE_URL="sqlite:///./careerbridge.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/careerbridge"

# AI / LLM Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Uploads
UPLOAD_DIR="./uploads"
