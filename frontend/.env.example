# Google OAuth Client ID from Google Cloud Console
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"

# Backend API URL (for production deployment e.g. on Vercel)
# If left unset, defaults to http://127.0.0.1:8050/api
# Example: https://careerbridge-backend.onrender.com/api
VITE_API_URL="http://127.0.0.1:8050/api"
